---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import osoPolar from "../assets/osopolarmejor.jpeg"
import Layout from '../layouts/global.astro';
const posts = await getCollection('blog');
const masReciente = posts.sort((a,b) => {return b.data.fechaPub.valueOf() - a.data.fechaPub.valueOf()})[0];
const proyectos = await getCollection('portafolio');
---
<Layout title="Blog">
    <div class="principal">
        <div class="contenido">
            <section class="carta carta-ancha">
                Intro
            </section>
            <section class="carta carta-chica">
                <Image src={osoPolar} alt="nada" style="height:255px"/>
            </section>
            <section class="carta carta-chica">
                <Image src={masReciente.data.portada} alt={masReciente.data.portadaAlt} style="height:255px"/>
            </section>
            <section class="carta carta-chica">
                <h2><a href={`/blog/${masReciente.id}`}>{masReciente.data.titulo}</a></h2>
               
                <p>{masReciente.data.descripcion}</p>
            </section>
            <section class="carta carta-chica">
                <p>Otra wea por venir</p>
            </section>
            <section class="carta carta-ancha">
                <ul>
                    {proyectos.map(proyecto =>(
                        <li><a href={`/portafolio/${proyecto.id}`}>{proyecto.data.nombre}</a></li>
                    ))}
                </ul>
            </section>
            <section class="carta carta-chica">
                <Image src={osoPolar} alt="nada" style="height:255px"/>
            </section>
        
        </div>
        <div class="lateral">
            <p>
                Hola desde lateral
            </p>
        </div>
        
    </div>
</Layout>