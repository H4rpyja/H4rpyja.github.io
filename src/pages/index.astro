---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
const posts = await getCollection('blog');
---
<head>
<meta charset="utf-8">
<style>
  h1 {
    color: orange;
  }
</style>
</head>
<h1>Posts</h1>
<ul>
  {posts.map(post => (
    <li><a href={`/blog/${post.id}`}>{post.data.titulo}</a></li>
    <Image src={post.data.portada} alt={post.data.portadaAlt} />
  ))}
</ul>
