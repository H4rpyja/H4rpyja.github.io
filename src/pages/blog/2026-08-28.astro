---
import { getEntry, render } from "astro:content";
import LayoutBlog from '../../layouts/blog.astro'
const entry =  await getEntry('blog','2026-08-28');
if(!entry){
    throw new Error("Entrada no encontrada");
}
const fechaAct = entry.data.fechaAct ? entry.data.fechaAct.toLocaleDateString("en-GB") : entry.data.fechaAct

const { Content } = await render(entry);
---
<LayoutBlog titleBlog={entry.data.titulo} date={entry.data.fechaPub.toLocaleDateString("en-GB")} update={fechaAct}>
<Content />
</LayoutBlog>
