---
import '../styles/global.css'
import ldeathnote from "../assets/l_deathnote.jpg";
import { Image } from "astro:assets";

const { title } = Astro.props
---
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">
        <title>{title}</title>
    </head>
    <body>
        <div style="display: flex; flex-direction: column;">
            <div class="principal">
                <slot />
                
                <div class="lateral">
                    <div class="lateral-arriba">
                        <p class="titulo-index">H4rpyja</p>

                    </div>
                    <hr/>
                    <Image src={ldeathnote} alt="foto" style="height:255px; border: double white;"/>
                    <nav class="menu">
                        <a class="enlace-menu" href="/index.html">Índice</a>
                        <a class="enlace-menu" href="/blog/index.html">Blog</a>
                        <a class="enlace-menu" href="/portafolio/index.html">Portafolio</a>
                    </nav>
                
                </div>
            </div>
            <footer>2026 @ Motopapus</footer>
        </div>
    </body>
</html>